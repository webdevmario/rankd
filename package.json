{
  "name": "rankd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prod:install": "cp scripts/com.rankd.plist ~/Library/LaunchAgents/com.rankd.plist",
    "prod:start": "launchctl load ~/Library/LaunchAgents/com.rankd.plist",
    "prod:stop": "launchctl unload ~/Library/LaunchAgents/com.rankd.plist && lsof -ti:3010 | xargs kill -9 2>/dev/null || true",
    "prod:restart": "npm run prod:stop && npm run prod:start",
    "prod:deploy": "npm run db:migrate && npm run build && npm run prod:restart",
    "prod:status": "launchctl list | grep com.rankd",
    "prod:logs": "cat /tmp/rankd.log",
    "prod:errors": "cat /tmp/rankd-error.log",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "import:stacks": "node --env-file=../stacks/.env scripts/import-from-stacks.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "modern-screenshot": "^4.7.0",
    "next": "15.5.26",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "A personal ranking engine.",
  "engines": {
    "node": ">=20"
  }
}
